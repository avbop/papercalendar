from datetime import date

from colors import Color
from events import anniversary, event
from icons import Icon
from weeks import week_event


def customize_events(events: list[tuple[date, event | week_event]], year: int):
    birthday = anniversary(
        "Happy {} birthday!", Color.BIRTHDAY, Icon.BIRTHDAY, 1892, year
    )
    if birthday is not None:
        events.append((date(year, 1, 3), birthday))
